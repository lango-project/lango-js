{
  "name": "@lango-project/lango-js",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "lango": "src/cli.mjs"
  },
  "exports": {
    ".": "./src/compiler.mjs",
    "./runtime": "./src/runtime.mjs",
    "./database": "./src/database.mjs"
  },
  "files": [
    "src/*.mjs",
    "src/vendor/**",
    "src/template/**",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node src/cli.mjs build",
    "run": "node src/cli.mjs run",
    "test:lango": "node src/cli.mjs test",
    "test": "node --test test/**/*.test.mjs"
  },
  "engines": {
    "node": ">=24"
  }
}
