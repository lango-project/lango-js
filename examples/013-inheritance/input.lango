export main(args)

class Person
    methods
        describe()

Person(name)
    @name = name

Person:describe()
    return @name

export class Employee : Person
    methods
        describe()

Employee(name, id)
    super(name)
    @id = id

Employee:describe()
    return super.describe() + ": " + @id

main(args)
    employee = new Employee("Ada", 7)
    println(employee.describe())
