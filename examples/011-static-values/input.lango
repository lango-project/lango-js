export main(args)

class Constants
    static
        Answer = 42
    methods
        value()
        increase()

Constants:value()
    return @@Answer

Constants:increase()
    @@Answer = @@Answer + 1
    return @@Answer

main(args)
    constants = new Constants()
    println(Constants.Answer)
    println(constants.value())
    println(constants.increase())
