export main(args)

export class Account
    methods
        total()
    static
        zero()

Account(value)
    @value = value

Account:total()
    validate()
    return @value

Account:validate()
    return null

Account::zero()
    return create_zero()

Account::create_zero()
    return new Account(0)

main(args)
    account = Account.zero()
    println(account.total())
