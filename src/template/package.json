{
  "name": "lango-application",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "lango build src/main.lango --out dist/main.mjs",
    "run": "lango run src/main.lango",
    "test": "lango test test/main.lango",
    "format": "lango format src/main.lango"
  },
  "lango": {
    "source": "src/main.lango",
    "output": "dist/main.mjs"
  },
  "devDependencies": {
    "@lango-project/lango-js": "{{LANGO_VERSION}}"
  },
  "engines": {
    "node": ">=24"
  }
}
